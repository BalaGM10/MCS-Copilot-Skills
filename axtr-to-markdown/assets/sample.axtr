<?xml version="1.0" encoding="utf-8"?>
<TaskRecording>
  <TaskName>Vendor Invoice Creation</TaskName>
  <Description>Process for creating and posting a vendor invoice in Dynamics 365 Finance and Operations</Description>
  <Version>1.0</Version>
  <Steps>
    <TaskRecordingStep>
      <StepIndex>1</StepIndex>
      <TaskStepType>UserAction</TaskStepType>
      <Caption>Navigate to Accounts Payable</Caption>
      <Comment>Click the Accounts Payable module from the main navigation menu to access vendor invoice functions.</Comment>
      <FormId>MainMenu</FormId>
      <ControlName>AccountsPayable</ControlName>
      <ActionType>Click</ActionType>
      <Value></Value>
    </TaskRecordingStep>
    <TaskRecordingStep>
      <StepIndex>2</StepIndex>
      <TaskStepType>UserAction</TaskStepType>
      <Caption>Open Pending Vendor Invoices</Caption>
      <Comment>Navigate to Invoices &gt; Pending vendor invoices to view the list of invoices awaiting processing.</Comment>
      <FormId>VendInvoiceListPage</FormId>
      <ControlName>PendingInvoices</ControlName>
      <ActionType>Click</ActionType>
      <Value></Value>
    </TaskRecordingStep>
    <TaskRecordingStep>
      <StepIndex>3</StepIndex>
      <TaskStepType>UserAction</TaskStepType>
      <Caption>Create New Invoice</Caption>
      <Comment>Click the New button on the action pane to create a new vendor invoice record.</Comment>
      <FormId>VendInvoiceListPage</FormId>
      <ControlName>NewRecord</ControlName>
      <ActionType>Click</ActionType>
      <Value></Value>
    </TaskRecordingStep>
    <TaskRecordingStep>
      <StepIndex>4</StepIndex>
      <TaskStepType>UserAction</TaskStepType>
      <Caption>Enter Invoice Number</Caption>
      <Comment>Type the vendor's invoice number into the Invoice Number field. This must match the number on the physical or electronic invoice received from the vendor.</Comment>
      <FormId>VendInvoiceEditForm</FormId>
      <ControlName>InvoiceNumber</ControlName>
      <ActionType>Input</ActionType>
      <Value>INV-2026-00142</Value>
    </TaskRecordingStep>
    <TaskRecordingStep>
      <StepIndex>5</StepIndex>
      <TaskStepType>UserAction</TaskStepType>
      <Caption>Post the Invoice</Caption>
      <Comment>Click the Post button to finalize and post the vendor invoice. Ensure all required fields are completed before posting.</Comment>
      <FormId>VendInvoiceEditForm</FormId>
      <ControlName>PostInvoice</ControlName>
      <ActionType>Post</ActionType>
      <Value></Value>
    </TaskRecordingStep>
  </Steps>
</TaskRecording>
